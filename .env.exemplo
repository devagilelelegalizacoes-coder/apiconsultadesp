# ========================================
# DATABASE E CACHE (SUPABASE)
# ========================================
# URL do projeto Supabase (obrigatório para autenticação e fila)
SUPABASE_URL=https://<SUA_URL>.supabase.co
# Chave de acesso do Supabase (service_role preferencialmente)
SUPABASE_KEY=eyJhb...

# ========================================
# SEGURANÇA
# ========================================
# Segredo usado para assinar os tokens JWT (Login)
JWT_SECRET=super_secret_jwt_key_here
# Chave de criptografia para dados sensíveis salvos em banco (32 caracteres hexa)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ========================================
# CONFIGURAÇÃO DE NAVEGADOR
# ========================================
# Defina como "true" para rodar o navegador de forma oculta (ideal para produção/Linux)
# Defina como "false" para ver o navegador abrindo localmente durante debug
HEADLESS=true
# Navegador padrão dos scrapers: "chromium" ou "firefox"
BROWSER=chromium
# Canal do Chromium para TODOS os scrapers: "none", "chromium" (headless novo; trava o
# SEFAZ IPVA) ou "chrome" (Google Chrome instalado). Vazio = cada scraper usa o seu
# (Bradesco: headless novo; demais: padrão do Playwright).
CHROMIUM_CHANNEL=
# Ordem de navegadores por tentativa nas consultas do Bradesco (o portal bloqueia o Firefox)
BRADESCO_BROWSERS=chromium

# ========================================
# INTEGRAÇÕES DE TERCEIROS
# ========================================
# Captcha Solver (Recomendado 2captcha)
# Provedores suportados no código: anticaptcha, 2captcha
CAPTCHA_PROVIDER=anticaptcha
CAPTCHA_API_KEY=sua_chave_aqui

# (Opcional) Configuração de Proxy para evitar bloqueios de IP (Cloudflare/WAF)
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# (Opcional) API Placas (wdapi2.com.br) - consulta de veículo por placa
WDAPI_TOKEN=
